{
  "host": "127.0.0.1",
  "port": 8317,
  "activeGroups": [
    "openai",
    "claude"
  ],
  "groups": {
    "openai": {
      "priority": 100,
      "upstream": {
        "name": "openai-gateway",
        "baseUrl": "https://example.com/v1",
        "apiKey": ""
      },
      "models": {
        "gpt-5.6-sol": "gpt-5.4",
        "gpt-5.6-luna": "gpt-5.4-mini",
        "gpt-5.6-terra": "gpt-5.4"
      },
      "endpoints": [
        "responses",
        "chat",
        "models"
      ],
      "stripRequestFields": [
        "reasoning.summary"
      ],
      "injectMappedModels": true,
      "overrideModelList": false
    },
    "claude": {
      "priority": 90,
      "upstream": {
        "name": "anthropic",
        "baseUrl": "https://api.anthropic.com",
        "apiKey": "",
        "authStyle": "x-api-key"
      },
      "models": {
        "claude-sonnet": "claude-sonnet-4-6",
        "claude-opus": "claude-opus-4-1"
      },
      "endpoints": [
        "messages",
        "models"
      ]
    },
    "grok": {
      "priority": 10,
      "upstream": {
        "name": "grok",
        "baseUrl": "https://api.x.ai/v1",
        "apiKey": ""
      },
      "models": {
        "grok-fast": "grok-4.6"
      },
      "endpoints": [
        "chat",
        "models"
      ]
    }
  },
  "clientApiKeys": [
    {
      "name": "laptop",
      "key": "change-this-local-key",
      "enabled": true,
      "note": "本机 Codex"
    },
    {
      "name": "ci",
      "key": "change-this-ci-key",
      "enabled": false,
      "note": "需要时再启用"
    }
  ],
  "forwardClientAuthorization": false,
  "logging": {
    "enabled": true
  },
  "progress": {
    "enabled": true,
    "color": true,
    "refreshIntervalMs": 100
  },
  "monitor": {
    "enabled": true,
    "theme": "dark-green"
  },
  "requestLog": {
    "enabled": true,
    "limit": 500,
    "file": "logs/requests.jsonl"
  },
  "pricing": {
    "currency": "USD",
    "models": {
      "claude-opus-5": { "input": 5, "output": 25, "cacheRead": 0.5, "cacheWrite": 6.25 },
      "claude-sonnet*": { "input": 2, "output": 10 },
      "gpt-5.6-sol": { "input": 5, "output": 30, "cacheRead": 0.5 }
    }
  },
  "webui": {
    "enabled": true
  },
  "timeouts": {
    "connectTimeoutMs": 30000
  },
  "debug": false
}
